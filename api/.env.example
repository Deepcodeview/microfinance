APP_ENV=local
APP_DEBUG=true

DB_HOST=mysql
DB_PORT=3306
DB_NAME=finserve
DB_USER=finserve
DB_PASS=finserve_local

# Session token lifetime in minutes
TOKEN_TTL_MINUTES=480

# Login rate limit: max failed attempts per email+IP within the window
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# 32 random bytes, base64. Encrypts MFA secrets. Never commit the real one; rotating it disables existing MFA enrolments.
APP_KEY=

# Outbox delivery: none | log (see bin/send-notifications.php)
SMS_DRIVER=none

# Origins allowed to call the API cross-site (the Android apps). Comma-separated.
CORS_ORIGINS=http://localhost,https://localhost,capacitor://localhost
